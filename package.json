{
  "name": "nextauth-react-native",
  "version": "1.0.10",
  "description": "NextAuth utilities for React Native.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nextauth",
    "react-native",
    "authentication"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithkashi/nextauth-react-native"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "dependencies": {
    "axios": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "tsup": "^8.2.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
